{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoughtml.example/study/generic-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "relations"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "confidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "text": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "type", "to"],
        "properties": {
          "from": {"type": "string"},
          "type": {"enum": ["supports", "opposes"]},
          "to": {"type": "string"}
        }
      }
    }
  }
}
