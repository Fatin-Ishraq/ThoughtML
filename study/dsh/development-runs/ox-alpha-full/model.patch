@@ -0,0 +1,469 @@
+"""Tests for partial structuring."""
+
+from dataclasses import dataclass
+from typing import Dict, List, Optional
+
+import cattrs
+import pytest
+from attrs import define, field
+from typing_extensions import NotRequired, TypedDict
+
+from cattrs import BaseConverter, Converter, PartialResult
+from cattrs.errors import ClassValidationError, ForbiddenExtraKeysError
+
+
+@define
+class Simple:
+    a: int
+    b: str = "default"
+
+
+@define
+class Inner:
+    a: int
+    b: int = 2
+
+
+@define
+class Outer:
+    inner: Inner
+    c: int = 3
+
+
+@dataclass
+class DataSimple:
+    a: int
+    b: str = "default"
+
+
+class SimpleTypedDict(TypedDict):
+    a: int
+    b: NotRequired[str]
+
+
+def test_complete(converter):
+    """Fully successful partial structuring produces a complete result."""
+    res = converter.partial_structure({"a": 1, "b": "test"}, Simple)
+
+    assert res.value == Simple(1, "test")
+    assert res.is_complete is True
+    assert isinstance(res.structured_fields, frozenset)
+    assert res.structured_fields == frozenset(["a", "b"])
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+    assert res.error_map == {}
+
+
+def test_missing_with_default(converter):
+    """Fields missing from the input are failed, and defaults are used."""
+    res = converter.partial_structure({"a": 1}, Simple)
+
+    assert res.value == Simple(1, "default")
+    assert res.is_complete is False
+    assert res.structured_fields == frozenset(["a"])
+    assert res.failed_fields == frozenset(["b"])
+    assert isinstance(res.error_map["b"], KeyError)
+    if converter.detailed_validation:
+        assert isinstance(res.errors, ClassValidationError)
+        assert len(res.errors.exceptions) == 1
+    else:
+        assert isinstance(res.errors, KeyError)
+
+
+def test_missing_required(converter):
+    """Missing required fields prevent a value from being produced."""
+    res = converter.partial_structure({}, Simple)
+
+    assert res.value is None
+    assert res.is_complete is False
+    assert res.structured_fields == frozenset()
+    assert res.failed_fields == frozenset(["a", "b"])
+    assert set(res.error_map) == {"a", "b"}
+    assert res.errors is not None
+
+
+def test_invalid_required(converter):
+    """Invalid required fields prevent a value from being produced."""
+    res = converter.partial_structure({"a": "not an int", "b": "x"}, Simple)
+
+    assert res.value is None
+    assert res.structured_fields == frozenset(["b"])
+    assert res.failed_fields == frozenset(["a"])
+    assert set(res.error_map) == {"a"}
+
+
+def test_fallback_to_defaults(converter):
+    """Failed fields with defaults fall back to these defaults."""
+
+    @define
+    class DefaultsOnly:
+        a: int = 1
+        b: str = "b"
+
+    res = converter.partial_structure({"a": "not an int", "b": 1}, DefaultsOnly)
+
+    assert res.value == DefaultsOnly(a=1, b="1")
+    assert res.is_complete is False
+    assert res.structured_fields == frozenset(["b"])
+    assert res.failed_fields == frozenset(["a"])
+
+
+def test_nested_complete(converter):
+    """Complete nested classes produce structured parent fields."""
+    res = converter.partial_structure(
+        {"inner": {"a": 1, "b": 5}, "c": 4},
+        Outer,
+    )
+
+    assert res.value == Outer(Inner(1, 5), 4)
+    assert res.is_complete is True
+    assert res.structured_fields == frozenset(["inner", "c"])
+    assert res.failed_fields == frozenset()
+
+
+def test_nested_partial(converter):
+    """Partially structured nested classes produce partial values, and the
+    parent fields are marked as failed."""
+    res = converter.partial_structure({"inner": {"a": 1}}, Outer)
+
+    assert res.value == Outer(Inner(1, 2))
+    assert res.is_complete is False
+    assert res.structured_fields == frozenset()
+    assert res.failed_fields == frozenset(["inner", "c"])
+    assert "inner" in res.error_map
+    assert res.error_map["inner"] is not None
+
+
+def test_nested_impossible(converter):
+    """When no nested value can be produced, it's a normal field failure."""
+    res = converter.partial_structure({"inner": {}}, Outer)
+
+    # `Outer.inner` has no default, so no value can be produced.
+    assert res.value is None
+    assert res.failed_fields == frozenset(["inner", "c"])
+
+    @define
+    class NestedWithDefault:
+        inner: Inner = Inner(9)
+
+    res = converter.partial_structure({"inner": {}}, NestedWithDefault)
+
+    # Here, the default is used as a fallback.
+    assert res.value == NestedWithDefault(Inner(9))
+    assert res.failed_fields == frozenset(["inner"])
+
+
+def test_collections_are_atomic(converter):
+    """Collection fields fail as a whole if any element fails."""
+
+    @define
+    class WithCollections:
+        ints: List[int]
+        mapping: Dict[str, int]
+        inners: List[Inner] = []
+
+    res = converter.partial_structure(
+        {"ints": [1, "x"], "mapping": {"a": 1}, "inners": [{"a": 1}]},
+        WithCollections,
+    )
+    assert res.value is None
+    assert res.structured_fields == frozenset(["mapping", "inners"])
+    assert res.failed_fields == frozenset(["ints"])
+
+    res = converter.partial_structure(
+        {"ints": [1], "mapping": {"a": "x"}, "inners": []}, WithCollections
+    )
+    assert res.value is None
+    assert res.structured_fields == frozenset(["ints", "inners"])
+    assert res.failed_fields == frozenset(["mapping"])
+
+    # A failing element fails the entire collection, even for nested classes.
+    # Since all other fields structured fine, a value is still produced.
+    res = converter.partial_structure(
+        {"ints": [1], "mapping": {}, "inners": [{"a": 1}, {}]}, WithCollections
+    )
+    assert res.value == WithCollections([1], {}, [])
+    assert res.is_complete is False
+    assert res.structured_fields == frozenset(["ints", "mapping"])
+    assert res.failed_fields == frozenset(["inners"])
+
