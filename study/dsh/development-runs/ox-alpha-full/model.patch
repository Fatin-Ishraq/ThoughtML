+            if extra_keys:
+                # Just like generated hooks, we complain about extra keys
+                # before doing any structuring.
+                errors.append(ForbiddenExtraKeysError("", cl, extra_keys))
+                extra_keys_problem = True
+
+        for a in attribs:
+            if not a.init:
+                # These fields aren't structured from mappings at all.
+                continue
+            name = a.name
+            key = a.alias if use_alias else name
+
+            if key not in data:
+                handle_failure(a, KeyError(key))
+                continue
+
+            val = data[key]
+            nested_cl = _partially_structurable(a.type)
