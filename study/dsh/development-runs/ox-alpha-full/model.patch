+
+        value = None
+        if not fatal:
+            try:
+                value = cl(**kwargs)
+            except Exception as exc:
+                # Most likely a validator rejecting our fallbacks.
+                errors.append(exc)
+
+        error = _aggregate_errors(errors, cl, detailed_validation)
+        return PartialResult(
+            value,
+            value is not None and not failed and not extra_keys_problem,
+            frozenset(structured),
+            frozenset(failed),
+            error,
+            error_map,
+            self,
+            cl,
+            data,
+        )
+
+    def _partial_structure_typeddict(
+        self, data: Mapping[str, Any], cl: type[T], base_error: Exception | None = None
+    ) -> PartialResult[T]:
+        """Partially structure a TypedDict."""
+        attribs = _typeddict_adapted_fields(cl)
+        req_keys = _typeddict_required_keys(cl)
+        detailed_validation = self.detailed_validation
+        forbid_extra_keys = getattr(self, "forbid_extra_keys", False)
+
+        res = {}
+        structured = []
+        failed = []
+        error_map: dict[str, Exception] = {}
+        errors: list[Exception] = [base_error] if base_error is not None else []
+        extra_keys_problem = False
+
+        def attach_note(exc: Exception, name: str, type: Any) -> Exception:
+            if detailed_validation:
+                exc.__notes__ = [
+                    *getattr(exc, "__notes__", []),
+                    AttributeValidationNote(
+                        f"Structuring class {cl.__qualname__} @ attribute {name}",
+                        name,
+                        type,
+                    ),
+                ]
+            return exc
+
+        def handle_failure(name: str, type: Any, exc: Exception) -> None:
+            nonlocal fatal
+            failed.append(name)
+            error_map[name] = attach_note(exc, name, type)
+            errors.append(error_map[name])
+            if name in req_keys:
+                fatal = True
+
+        fatal = False
+
+        known_keys = {a.name for a in attribs}
+
+        if forbid_extra_keys:
+            extra_keys = set(data) - known_keys
+            if extra_keys:
+                errors.append(ForbiddenExtraKeysError("", cl, extra_keys))
+                extra_keys_problem = True
+
+        for a in attribs:
+            name = a.name
+            type = a.type
+            nrb = get_notrequired_base(type)
+            if nrb is not NOTHING:
+                type = nrb
+
+            if name not in data:
+                handle_failure(name, type, KeyError(name))
+                continue
+
+            val = data[name]
+            nested_cl = _partially_structurable(type)
+            if nested_cl is not None:
+                nested = self.partial_structure(val, nested_cl)
+                if nested.value is not None:
+                    res[name] = nested.value
+                    if nested.is_complete:
+                        structured.append(name)
+                    else:
+                        failed.append(name)
+                        if nested.errors is not None:
+                            error_map[name] = attach_note(nested.errors, name, type)
+                            errors.append(error_map[name])
+                else:
+                    handle_failure(
+                        name,
+                        type,
+                        nested.errors
+                        if nested.errors is not None
+                        else ValueError(f"Cannot structure {name} from {val!r}"),
+                    )
+                continue
+
+            try:
+                res[name] = self._structure_func.dispatch(type)(val, type)
+            except Exception as exc:
+                handle_failure(name, type, exc)
+            else:
+                structured.append(name)
+
+        value = None if fatal else res
+
+        error = _aggregate_errors(errors, cl, detailed_validation)
+        return PartialResult(
+            value,
+            value is not None and not failed and not extra_keys_problem,
+            frozenset(structured),
+            frozenset(failed),
+            error,
+            error_map,
+            self,
+            cl,
+            data,
+        )
