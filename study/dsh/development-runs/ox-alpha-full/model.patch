+                else:
+                    # Nothing could be produced, so this is a normal failure.
+                    handle_failure(
+                        a,
+                        nested.errors
+                        if nested.errors is not None
+                        else ValueError(f"Cannot structure {a.name} from {val!r}"),
+                    )
+                continue
+
+            try:
+                kwargs[a.alias] = self._structure_attribute(a, val)
+            except Exception as exc:
