index 0000000..0bdb8f2
--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,90 @@
+"""Partial structuring support."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import TYPE_CHECKING, Any, Generic, TypeVar
+
+from attrs import define, field
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+__all__ = ["PartialResult"]
+
+T = TypeVar("T")
+
+
+@define(frozen=True)
+class PartialResult(Generic[T]):
+    """The result of a partial structuring operation.
+
+    Produced by :meth:`cattrs.BaseConverter.partial_structure`.
+
+    .. versionadded:: 25.4.0
+    """
+
+    #: The (potentially partially) structured value, or `None` if no value
+    #: could be produced at all.
+    value: T | None
+
+    #: Whether the value was completely structured from the input. A result
+    #: can be incomplete if any fields failed to structure, or (when
+    #: `forbid_extra_keys` is enabled) if extra keys were present in the input.
+    is_complete: bool
+
+    #: The names of fields that were successfully structured from the input.
+    structured_fields: frozenset[str]
+
+    #: The names of fields that could not be structured from the input.
+    #: Fields missing from the input are also considered failed.
+    failed_fields: frozenset[str]
+
+    #: The error (or errors, when detailed validation is enabled) encountered
+    #: while structuring, if any.
+    errors: Exception | None
+
+    #: A mapping of field names to the exceptions raised while structuring them.
+    error_map: dict[str, Exception]
+
+    # Private state, so `refine` can do its job.
+    _converter: BaseConverter | None = field(default=None, eq=False, repr=False)
+    _cl: Any = field(default=None, eq=False, repr=False)
+    _data: Any = field(default=None, eq=False, repr=False)
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:
+        """Attempt to fix the failed fields of this result using new data.
+
+        Fields present in `data` are used to fix the failed (including
+        missing) fields of the original input; successfully structured fields
+        are preserved as-is and cannot be overwritten. When both the old and
+        the new value for a field are mappings (for example, when fixing up a
+        partially structured nested class), they are merged recursively, with
+        the new data taking precedence.
+
+        :param data: A mapping of field names to new, unstructured values.
+        """
+        if self._converter is None:
+            raise ValueError("This partial result cannot be refined.")
+        fixed = dict(self._data) if isinstance(self._data, Mapping) else {}
+        for key, value in data.items():
+            if key in self.structured_fields:
+                continue
+            old = fixed.get(key)
+            if isinstance(old, Mapping) and isinstance(value, Mapping):
+                fixed[key] = _merge(old, value)
+            else:
+                fixed[key] = value
+        return self._converter.partial_structure(fixed, self._cl)
+
+
+def _merge(old: Mapping[str, Any], new: Mapping[str, Any]) -> dict[str, Any]:
+    """Merge two mappings recursively; the new data takes precedence."""
+    res = dict(old)
+    for key, value in new.items():
+        old_value = res.get(key)
+        if isinstance(old_value, Mapping) and isinstance(value, Mapping):
+            res[key] = _merge(old_value, value)
+        else:
+            res[key] = value
+    return res
