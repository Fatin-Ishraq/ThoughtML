+def test_forbid_extra_keys():
+    """Extra keys make the result incomplete, but a value is still produced."""
+    converter = Converter(forbid_extra_keys=True)
+    res = converter.partial_structure({"a": 1, "d": 4}, Simple)
+
+    assert res.value == Simple(1, "default")
+    assert res.is_complete is False
+    assert res.structured_fields == frozenset(["a"])
+    assert res.failed_fields == frozenset(["b"])
+    assert isinstance(res.errors, ClassValidationError)
+    assert isinstance(res.errors.exceptions[0], ForbiddenExtraKeysError)
+
+
+def test_extra_keys_allowed(converter):
+    """Without `forbid_extra_keys`, extra keys are ignored."""
+    res = converter.partial_structure({"a": 1, "b": "x", "d": 4}, Simple)
+
+    assert res.value == Simple(1, "x")
+    assert res.is_complete is True
+
