+    def partial_structure(self, obj: Any, cl: type[T]) -> PartialResult[T]:
+        """Structure as much of the input into `cl` as possible.
+
+        Unlike :meth:`structure`, this method doesn't raise when a field cannot
+        be structured. Instead, a :class:`cattrs.PartialResult` is returned,
+        containing a best-effort value and detailed information about the
+        failures:
+
+        * Fields missing from the input are considered failed.
+        * Failed fields with defaults fall back to these defaults; failed
+          fields without defaults prevent a value from being produced at all.
+        * Nested _attrs_ classes, dataclasses and TypedDicts are partially
+          structured recursively. If a nested class can only be partially
+          structured, its partial value is used and the containing field is
+          marked as failed.
+        * Collections (such as lists and dicts) are structured atomically;
+          a single failing element fails the entire field.
+
+        This method is significantly slower than :meth:`structure`, since it
+        cannot use generated hooks.
+
+        :param obj: The unstructured input, a mapping of field names to values.
+        :param cl: The type to structure into; an _attrs_ class, a dataclass or
+            a TypedDict.
+
+        .. versionadded:: 25.4.0
+        """
+        if is_annotated(cl):
+            return self.partial_structure(obj, cl.__origin__)
+
+        if is_typeddict(cl):
+            if is_generic(cl):
+                return self._partial_structure_fallback(obj, cl)
+            data, base_error = _as_mapping(obj)
+            return self._partial_structure_typeddict(data, cl, base_error)
+        if has(cl) and not is_generic(cl):
+            data, base_error = _as_mapping(obj)
+            return self._partial_structure_attrs(data, cl, base_error)
+        return self._partial_structure_fallback(obj, cl)
+
+    def _partial_structure_fallback(self, data: Any, cl: Any) -> PartialResult[Any]:
+        """Partially structure a type we cannot break down into fields."""
+        try:
+            value = self.structure(data, cl)
+        except Exception as exc:
+            return PartialResult(
+                None, False, frozenset(), frozenset(), exc, {}, self, cl, data
+            )
+        return PartialResult(
+            value, True, frozenset(), frozenset(), None, {}, self, cl, data
+        )
+
+    def _partial_structure_attrs(
+        self, data: Mapping[str, Any], cl: type[T], base_error: Exception | None = None
+    ) -> PartialResult[T]:
+        """Partially structure an _attrs_ class or a dataclass."""
+        attribs = adapted_fields(cl)
+        detailed_validation = self.detailed_validation
+        forbid_extra_keys = getattr(self, "forbid_extra_keys", False)
+        use_alias = getattr(self, "use_alias", False)
+
+        kwargs = {}
+        structured = []
+        failed = []
+        error_map: dict[str, Exception] = {}
+        errors: list[Exception] = [base_error] if base_error is not None else []
+        extra_keys_problem = False
+
+        def attach_note(exc: Exception, name: str, type: Any) -> Exception:
+            """Attach a validation note, just like generated hooks do."""
+            if detailed_validation:
+                exc.__notes__ = [
+                    *getattr(exc, "__notes__", []),
+                    AttributeValidationNote(
+                        f"Structuring class {cl.__qualname__} @ attribute {name}",
+                        name,
+                        type,
+                    ),
+                ]
+            return exc
+
+        def handle_failure(a: Attribute, exc: Exception) -> None:
+            """A field could not be structured; fall back to its default."""
