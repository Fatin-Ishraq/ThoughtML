+def test_optional_fields(converter):
+    """Unions (and optionals) are structured atomically."""
+
+    @define
+    class WithOptional:
+        a: Optional[Inner] = None
+
+    res = converter.partial_structure({"a": {"a": 1, "b": 2}}, WithOptional)
+
+    # Valid input is structured normally.
+    assert res.value == WithOptional(Inner(1, 2))
+    assert res.is_complete is True
+
+    # Invalid input fails the whole field, falling back to the default.
+    res = converter.partial_structure({"a": {"b": 1}}, WithOptional)
+
+    assert res.value == WithOptional(None)
+    assert res.failed_fields == frozenset(["a"])
