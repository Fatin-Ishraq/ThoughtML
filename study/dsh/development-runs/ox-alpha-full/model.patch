+def test_detailed_validation_notes():
+    """Detailed validation attaches notes and aggregates errors."""
+    converter = Converter(detailed_validation=True)
+    res = converter.partial_structure({"a": "x"}, Simple)
+
+    assert isinstance(res.errors, ClassValidationError)
+    exc = res.error_map["a"]
+    assert exc.__notes__[-1].name == "a"
+    assert res.errors.exceptions[0] is exc
+
+    # The aggregate error can be formatted.
+    assert len(cattrs.transform_error(res.errors)) > 0
+
+
+def test_no_detailed_validation():
+    """Without detailed validation, the first error is reported directly."""
+    converter = Converter(detailed_validation=False)
+    res = converter.partial_structure({}, Simple)
+
+    assert res.value is None
+    assert not isinstance(res.errors, ClassValidationError)
+    assert isinstance(res.errors, KeyError)
+    assert res.errors is res.error_map[next(iter(res.error_map))]
+
