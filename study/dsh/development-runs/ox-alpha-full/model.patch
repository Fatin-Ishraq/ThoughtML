+def test_refine(converter):
+    """Refining fixes failed fields, preserving structured ones."""
+    res = converter.partial_structure({"a": "not an int", "b": "x"}, Simple)
+
+    refined = res.refine({"a": 1})
+
+    assert refined.value == Simple(1, "x")
+    assert refined.is_complete is True
+    assert refined.structured_fields == frozenset(["a", "b"])
+    assert refined.failed_fields == frozenset()
+
+    # The old result is unchanged.
+    assert res.value is None
+    assert res.failed_fields == frozenset(["a"])
+
+
+def test_refine_preserves_structured_fields(converter):
+    """Refining cannot overwrite successfully structured fields."""
+    res = converter.partial_structure({"a": 1}, Simple)
+
+    refined = res.refine({"a": 100, "b": "fixed"})
+
+    assert refined.value == Simple(1, "fixed")
+    assert refined.is_complete is True
+    assert refined.structured_fields == frozenset(["a", "b"])
+
+
+def test_refine_missing_fields(converter):
+    """Refining can provide entirely missing fields."""
+    res = converter.partial_structure({}, Simple)
+
+    refined = res.refine({"a": 1, "b": "provided"})
+
+    assert refined.value == Simple(1, "provided")
+    assert refined.is_complete is True
+
+
+def test_refine_nested_merges(converter):
+    """Refining merges mappings recursively, fixing nested failures."""
+    res = converter.partial_structure({"inner": {"a": 1}, "c": 4}, Outer)
+
+    assert not res.is_complete
+
+    refined = res.refine({"inner": {"b": 7}})
+
+    assert refined.value == Outer(Inner(1, 7), 4)
+    assert refined.is_complete is True
+
