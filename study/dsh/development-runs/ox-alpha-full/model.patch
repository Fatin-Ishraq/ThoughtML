+def test_typeddicts(converter):
+    """TypedDicts are supported, with required and non-required keys."""
+    res = converter.partial_structure({"a": 1, "b": "x"}, SimpleTypedDict)
+
+    assert res.value == {"a": 1, "b": "x"}
+    assert res.is_complete is True
+    assert res.structured_fields == frozenset(["a", "b"])
+
+    # Non-required keys can be missing.
+    res = converter.partial_structure({"a": 1}, SimpleTypedDict)
+    assert res.value == {"a": 1}
+    assert res.is_complete is False
+    assert res.structured_fields == frozenset(["a"])
+    assert res.failed_fields == frozenset(["b"])
+
+    # Required keys cannot.
+    res = converter.partial_structure({"b": "x"}, SimpleTypedDict)
+    assert res.value is None
+    assert res.structured_fields == frozenset(["b"])
+    assert res.failed_fields == frozenset(["a"])
+
+    refined = res.refine({"a": 1})
+    assert refined.value == {"a": 1, "b": "x"}
+    assert refined.is_complete is True
+
