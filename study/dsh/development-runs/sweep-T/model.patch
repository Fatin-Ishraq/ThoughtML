+def test_detailed_errors(converter: BaseConverter):
+    """Errors are aggregated appropriately for the validation mode."""
+    res = converter.partial_structure({"a": "test", "b": "test", "c": ["a"]}, Simple)
+
+    assert set(res.error_map) == {"a", "c"}
+
+    if converter.detailed_validation:
+        assert isinstance(res.errors, ClassValidationError)
+        assert len(res.errors.exceptions) == 2
+
+        # The notes make the errors usable by `transform_error`.
+        messages = transform_error(res.errors)
+        assert len(messages) == 2
+    else:
+        assert isinstance(res.errors, ValueError)
