diff --git a/src/cattrs/partials.py b/src/cattrs/partials.py
new file mode 100644
index 0000000..ed703de
--- /dev/null
+++ b/src/cattrs/partials.py
@@ -0,0 +1,442 @@
+"""Partial structuring: structure as much of the payload as possible."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping as AbcMapping
+from typing import TYPE_CHECKING, Any, Generic, Optional, TypeVar
+
+from attrs import NOTHING, Attribute, field, frozen
+
+from ._compat import (
+    adapted_fields,
+    get_notrequired_base,
+    get_origin,
+    has,
+    is_annotated,
+    is_bare,
+    is_generic,
+    is_typeddict,
+)
+from ._generics import deep_copy_with
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+)
+from .gen._consts import AttributeOverride, neutral
+from .gen._generics import generate_mapping
+from .gen._shared import _annotated_override_or_default, find_structure_handler
+from .gen.typeddicts import _adapted_fields as _typeddict_adapted_fields
+from .gen.typeddicts import _required_keys as _typeddict_required_keys
+
+if TYPE_CHECKING:
+    from collections.abc import Mapping
+
+    from .converters import BaseConverter
+
+__all__ = ["PartialResult", "partial_structure"]
+
+T = TypeVar("T")
+
+
+@frozen
+class PartialResult(Generic[T]):
+    """The result of a partial structuring operation.
+
+    Produced by :meth:`cattrs.BaseConverter.partial_structure`.
+
+    .. versionadded:: NEXT
+    """
+
+    value: Optional[T] = None
+    """The (potentially partial) structured value, or `None` if impossible."""
+
+    is_complete: bool = False
+    """Was the payload structured completely, with nothing lost?"""
+
+    structured_fields: frozenset[str] = frozenset()
+    """The names of fields successfully structured from the input."""
+
+    failed_fields: frozenset[str] = frozenset()
+    """The names of fields that could not be structured from the input.
+
+    Fields absent from the input are considered failed, too.
+    """
+
+    errors: Optional[Exception] = None
+    """The errors encountered while structuring, if any.
+
+    Under detailed validation this is a `ClassValidationError` containing all
+    errors; otherwise it is the first raw exception.
+    """
+
+    error_map: dict[str, Exception] = field(factory=dict)
+    """A mapping of field names to the exceptions that failed them."""
+
+    _converter: Optional[BaseConverter] = field(default=None, eq=False, repr=False)
+    _cl: Any = field(default=None, eq=False, repr=False)
+    _input: Any = field(default=None, eq=False, repr=False)
+
+    def refine(self, data: Mapping[str, Any]) -> PartialResult[T]:
+        """Fix failed fields using new data, returning a new partial result.
+
+        The new data is merged into the original payload (mappings being merged
+        recursively) and the payload is partially structured again. Fields that
+        have been structured successfully keep their payloads, so they remain
+        structured unless explicitly overridden.
+        """
+        if self._converter is None:
+            raise TypeError("This partial result cannot be refined.")
+        return self._converter.partial_structure(
+            _deep_merge(self._input, data), self._cl
+        )
+
+
+def partial_structure(
+    converter: BaseConverter, obj: Any, cl: type[T]
+) -> PartialResult[T]:
+    """Structure as much of `obj` into `cl` as possible.
+
+    Supports _attrs_ classes, dataclasses and TypedDicts; anything else is
+    structured atomically.
+
+    .. versionadded:: NEXT
+    """
+    if is_typeddict(cl):
+        return _partial_structure_typeddict(converter, obj, cl)
+    origin = get_origin(cl)
+    if has(cl) or (origin is not None and has(origin)):
+        return _partial_structure_attrs(converter, obj, cl)
+
+    # Not a class we can take apart, so it gets structured atomically.
+    try:
+        value = converter.structure(obj, cl)
+    except Exception as exc:
+        return PartialResult(errors=exc, converter=converter, cl=cl, input=obj)
+    return PartialResult(value, True, converter=converter, cl=cl, input=obj)
+
+
+def _deep_merge(base: Any, patch: Mapping[str, Any]) -> dict:
+    """Merge two mappings recursively, with `patch` winning."""
+    res = dict(base) if isinstance(base, AbcMapping) else {}
+    for key, value in patch.items():
+        if isinstance(value, AbcMapping) and isinstance(res.get(key), AbcMapping):
+            res[key] = _deep_merge(res[key], value)
+        else:
+            res[key] = value
+    return res
+
+
+def _hook_overrides(converter: BaseConverter, cl: Any) -> dict:
+    """Fetch the field overrides of the registered structure hook, if any."""
+    try:
+        hook = converter.get_structure_hook(cl)
+    except Exception:
+        # No usable hook; we fly without overrides.
+        return {}
+    overrides = getattr(hook, "overrides", None)
+    return overrides if overrides is not None else {}
+
+
+def _resolve_override(
+    overrides: dict, attrib: Attribute, type: Any
+) -> AttributeOverride:
+    """Find the override for an attribute, looking into `Annotated` types too."""
+    override = overrides.get(attrib.name, neutral)
+    if override == neutral:
+        override = _annotated_override_or_default(type, neutral)
+    return override
+
+
+def _aggregate(
+    cl: Any,
+    entries: list[tuple[Optional[str], Exception, Any]],
+    detailed_validation: bool,
+    kind: str,
+) -> Optional[Exception]:
+    """Produce the aggregate exception for a partial structuring attempt.
+
+    Entries are `(field name, exception, field type)` tuples; a `None` field
+    name means the exception cannot be attributed to a field.
+    """
+    if not entries:
+        return None
+    if not detailed_validation:
+        return entries[0][1]
+    for name, exc, type in entries:
+        if name is not None:
+            note = AttributeValidationNote(
+                f"Structuring {kind} {cl.__qualname__} @ attribute {name}", name, type
+            )
+            exc.__notes__ = [*getattr(exc, "__notes__", []), note]
+    return ClassValidationError(
+        "While structuring " + cl.__name__, [entry[1] for entry in entries], cl
+    )
+
+
+def _partial_structure_attrs(
+    converter: BaseConverter, obj: Any, cl: Any
+) -> PartialResult:
+    """Partially structure an _attrs_ class or a dataclass."""
+    detailed_validation = converter.detailed_validation
+    forbid_extra_keys = getattr(converter, "forbid_extra_keys", False)
+    use_alias = getattr(converter, "use_alias", False)
+
+    typevar_map = {}
+    if is_generic(cl):
+        attribs = adapted_fields(get_origin(cl))
+        typevar_map = generate_mapping(cl)
+    else:
+        attribs = adapted_fields(cl)
+
+    overrides = _hook_overrides(converter, cl)
+
+    def is_considered(a) -> bool:
+        override = _resolve_override(overrides, a, a.type)
+        if override.omit is not None:
+            return not override.omit
+        return a.init
+
+    if not isinstance(obj, AbcMapping):
+        failed = frozenset(a.name for a in attribs if is_considered(a))
+        exc = ValueError(f"Cannot partially structure {obj!r}: not a mapping.")
+        errors = (
+            ClassValidationError("While structuring " + cl.__name__, [exc], cl)
+            if detailed_validation
+            else exc
+        )
+        return PartialResult(
+            failed_fields=failed, errors=errors, converter=converter, cl=cl, input=obj
+        )
+
+    kwargs = {}
+    structured = []
+    failed = []
+    error_map: dict[str, Exception] = {}
+    # Entries of (field name, exception, field type); a null name is unkeyed.
+    entries: list[tuple[Optional[str], Exception, Any]] = []
+    allowed_keys = set()
+    can_instantiate = True
+
+    for a in attribs:
+        an = a.name
+        override = _resolve_override(overrides, a, a.type)
+
+        if override.omit:
+            continue
+        if override.omit is None and not a.init:
+            continue
+
+        t = a.type
+        if isinstance(t, TypeVar):
+            t = typevar_map.get(t.__name__, t)
+        elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+            t = deep_copy_with(t, typevar_map, cl)
+
+        kn = override.rename
+        if kn is None:
+            kn = a.alias if use_alias else an
+        allowed_keys.add(kn)
+
+        if kn not in obj:
+            exc = KeyError(kn)
+            failed.append(an)
+            error_map[an] = exc
+            entries.append((an, exc, t))
+            if a.default is NOTHING:
+                can_instantiate = False
+            continue
+
+        val = obj[kn]
+        inner = t.__origin__ if is_annotated(t) else t
+
+        if override.struct_hook is None and (has(inner) or is_typeddict(inner)):
+            # Nested classes are structured partially, recursively.
+            nested = partial_structure(converter, val, inner)
+            if nested.is_complete:
+                kwargs[a.alias] = nested.value
+                structured.append(an)
+                continue
+            failed.append(an)
+            error_map[an] = nested.errors
+            entries.append((an, nested.errors, t))
+            if nested.value is not None:
+                # The parent keeps the partial value of the child.
+                kwargs[a.alias] = nested.value
+            elif a.default is NOTHING:
+                can_instantiate = False
+            continue
+
+        try:
+            handler = override.struct_hook
+            if handler is None:
+                handler = find_structure_handler(
+                    a, t, converter, converter._prefer_attrib_converters
+                )
+            res = val if handler is None else handler(val, t)
+        except Exception as exc:
+            failed.append(an)
+            error_map[an] = exc
+            entries.append((an, exc, t))
+            if a.default is NOTHING:
+                can_instantiate = False
+        else:
+            kwargs[a.alias] = res
+            structured.append(an)
+
+    if forbid_extra_keys:
+        extra_keys = set(obj.keys()) - allowed_keys
+        if extra_keys:
+            entries.append((None, ForbiddenExtraKeysError("", cl, extra_keys), None))
+
+    value = None
+    if can_instantiate:
+        try:
+            value = cl(**kwargs)
+        except Exception as exc:
+            # Most likely a validator or a class-level converter.
+            entries.append((None, exc, None))
+
+    return PartialResult(
+        value,
+        not entries and value is not None,
+        frozenset(structured),
+        frozenset(failed),
+        _aggregate(cl, entries, detailed_validation, "class"),
+        error_map,
+        converter=converter,
+        cl=cl,
+        input=obj,
+    )
+
+
+def _partial_structure_typeddict(
+    converter: BaseConverter, obj: Any, cl: Any
+) -> PartialResult:
+    """Partially structure a TypedDict."""
+    detailed_validation = converter.detailed_validation
+    forbid_extra_keys = getattr(converter, "forbid_extra_keys", False)
+
+    origin = get_origin(cl)
+    base = cl if origin is None else origin
+    attribs = _typeddict_adapted_fields(base)
+    required = _typeddict_required_keys(base)
+
+    typevar_map = {}
+    if is_generic(cl):
+        typevar_map = generate_mapping(cl)
+        for candidate in getattr(origin, "__orig_bases__", ()):
+            if is_generic(candidate) and not str(candidate).startswith(
+                "typing.Generic"
+            ):
+                typevar_map = generate_mapping(candidate, typevar_map)
+                break
+
+    overrides = _hook_overrides(converter, cl)
+
+    def is_considered(a) -> bool:
+        nrb = get_notrequired_base(a.type)
+        t = a.type if nrb is NOTHING else nrb
+        return not _resolve_override(overrides, a, t).omit
+
+    if not isinstance(obj, AbcMapping):
+        failed = frozenset(a.name for a in attribs if is_considered(a))
+        exc = ValueError(f"Cannot partially structure {obj!r}: not a mapping.")
+        errors = (
+            ClassValidationError("While structuring " + cl.__name__, [exc], cl)
+            if detailed_validation
+            else exc
+        )
+        return PartialResult(
+            failed_fields=failed, errors=errors, converter=converter, cl=cl, input=obj
+        )
+
+    res = {}
+    structured = []
+    failed = []
+    error_map: dict[str, Exception] = {}
+    entries: list[tuple[Optional[str], Exception, Any]] = []
+    allowed_keys = set()
+    can_produce = True
+
+    for a in attribs:
+        an = a.name
+        t = a.type
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            t = nrb
+
+        override = _resolve_override(overrides, a, t)
+        if override.omit:
+            continue
+
+        # Not-required keys may be absent, like defaulted fields.
+        has_default = an not in required
+
+        if isinstance(t, TypeVar):
+            t = typevar_map.get(t.__name__, t)
+        elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+            t = deep_copy_with(t, typevar_map, cl)
+
+        kn = an if override.rename is None else override.rename
+        allowed_keys.add(kn)
+
+        if kn not in obj:
+            exc = KeyError(kn)
+            failed.append(an)
+            error_map[an] = exc
+            entries.append((an, exc, t))
+            if not has_default:
+                can_produce = False
+            continue
+
+        val = obj[kn]
+        inner = t.__origin__ if is_annotated(t) else t
+
+        if override.struct_hook is None and (has(inner) or is_typeddict(inner)):
+            nested = partial_structure(converter, val, inner)
+            if nested.is_complete:
+                res[an] = nested.value
+                structured.append(an)
+                continue
+            failed.append(an)
+            error_map[an] = nested.errors
+            entries.append((an, nested.errors, t))
+            if nested.value is not None:
+                res[an] = nested.value
+            elif not has_default:
+                can_produce = False
+            continue
+
+        try:
+            handler = override.struct_hook
+            if handler is None:
+                handler = find_structure_handler(a, t, converter)
+            res[an] = val if handler is None else handler(val, t)
+        except Exception as exc:
+            failed.append(an)
+            error_map[an] = exc
+            entries.append((an, exc, t))
+            if not has_default:
+                can_produce = False
+        else:
+            structured.append(an)
+
+    if forbid_extra_keys:
+        extra_keys = set(obj.keys()) - allowed_keys
+        if extra_keys:
+            entries.append((None, ForbiddenExtraKeysError("", cl, extra_keys), None))
+
+    value = dict(res) if can_produce else None
+
+    return PartialResult(
+        value,
+        not entries and value is not None,
+        frozenset(structured),
+        frozenset(failed),
+        _aggregate(cl, entries, detailed_validation, "typeddict"),
+        error_map,
+        converter=converter,
+        cl=cl,
+        input=obj,
+    )
diff --git a/tests/test_partial.py b/tests/test_partial.py
new file mode 100644
index 0000000..72f06c2
--- /dev/null
+++ b/tests/test_partial.py
@@ -0,0 +1,586 @@
+"""Tests for partial structuring."""
+
+from dataclasses import dataclass
+from typing import Dict, Generic, List, Optional, TypeVar
+
+import pytest
+from typing_extensions import NotRequired, TypedDict
+
+import cattrs
+from attrs import define, field
+from cattrs import BaseConverter, Converter, PartialResult
+from cattrs.errors import ClassValidationError, ForbiddenExtraKeysError
+from cattrs.gen import make_dict_structure_fn, override
+from cattrs.v import transform_error
+
+T = TypeVar("T")
+
+
+@define
+class Inner:
+    a: int
+    b: str = "default"
+
+
+@define
+class Simple:
+    a: int
+    b: str = "default"
+    c: List[int] = field(factory=list)
+
+
+def test_complete(converter: BaseConverter):
+    """Complete payloads produce complete results."""
+    res = converter.partial_structure({"a": 1, "b": "test", "c": [1]}, Simple)
+
+    assert res.value == Simple(1, "test", [1])
+    assert res.is_complete
+    assert res.structured_fields == frozenset(["a", "b", "c"])
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+    assert res.error_map == {}
+
+
+def test_missing_optional_field(converter: BaseConverter):
+    """Fields absent from the payload are failed, and defaults are used."""
+    res = converter.partial_structure({"a": 1}, Simple)
+
+    assert res.value == Simple(1, "default", [])
+    assert not res.is_complete
+    assert res.structured_fields == frozenset(["a"])
+    assert res.failed_fields == frozenset(["b", "c"])
+    assert set(res.error_map) == {"b", "c"}
+    assert isinstance(res.errors, Exception)
+
+
+def test_missing_required_field(converter: BaseConverter):
+    """Required fields without defaults prevent a value."""
