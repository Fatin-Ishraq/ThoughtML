+def test_result_equality():
+    """Results of complete structuring can be compared."""
+    converter = Converter()
+    first = converter.partial_structure({"a": 1, "b": "test", "c": []}, Simple)
+    second = converter.partial_structure({"a": 1, "b": "test", "c": []}, Simple)
+
+    assert first == second
+
+    third = converter.partial_structure({"a": 2, "b": "test", "c": []}, Simple)
+
