+def test_refine(converter: BaseConverter):
+    """Refining fixes failed fields, preserving structured ones."""
+    res = converter.partial_structure({"c": [5]}, Simple)
+
+    assert res.failed_fields == frozenset(["a", "b"])
+
+    refined = res.refine({"a": 1})
+
+    assert refined.value == Simple(1, "default", [5])
+    assert not refined.is_complete
+    assert refined.structured_fields == frozenset(["a", "c"])
+    assert refined.failed_fields == frozenset(["b"])
+
+    refined = refined.refine({"b": "test"})
+
+    assert refined.value == Simple(1, "test", [5])
+    assert refined.is_complete
+    assert refined.failed_fields == frozenset()
+
+
