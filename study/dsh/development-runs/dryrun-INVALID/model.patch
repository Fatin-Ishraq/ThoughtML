+def test_partial_structure_forbid_extra_keys():
+    converter = Converter(forbid_extra_keys=True)
+
+    @define
+    class F:
+        a: int
+        b: str = "x"
+
+    res = converter.partial_structure({"a": 1, "b": "y", "extra": 5}, F)
+
+    # Extra keys make the result incomplete, but a value is still produced.
+    assert res.value == F(1, "y")
+    assert not res.is_complete
+    assert res.failed_fields == frozenset()
+    assert res.structured_fields == frozenset({"a", "b"})
+
+    res = converter.partial_structure({"a": 1, "b": "y"}, F)
+
+    assert res.value == F(1, "y")
+    assert res.is_complete
