+def test_partial_structure_init_false_excluded(converter: BaseConverter):
+    @define
+    class E:
+        a: int
+        b: int = field(init=False, default=42)
+
+    res = converter.partial_structure({"a": 1}, E)
+
+    assert res.value == E(1)
+    assert res.is_complete
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset()
+    assert res.errors is None
+
+    # `init=False` fields don't participate even when present in the input.
+    res = converter.partial_structure({"a": 1, "b": 100}, E)
+
+    assert res.value == E(1)
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset()
