+def test_partial_structure_collections_atomic(converter: BaseConverter):
+    @define
+    class C:
+        lst: list[int]
+        d: dict[str, int]
+
+    # Any element failure fails the whole field.
+    res = converter.partial_structure({"lst": [1, "bad"], "d": {"a": 1}}, C)
+
+    assert res.value is None
+    assert res.failed_fields == frozenset({"lst"})
+    assert res.structured_fields == frozenset({"d"})
+    assert isinstance(res.error_map["lst"], Exception)
+
+    res = converter.partial_structure({"lst": [1, 2], "d": {"a": "bad"}}, C)
+
+    assert res.value is None
+    assert res.failed_fields == frozenset({"d"})
+    assert res.structured_fields == frozenset({"lst"})
+    assert isinstance(res.error_map["d"], Exception)
