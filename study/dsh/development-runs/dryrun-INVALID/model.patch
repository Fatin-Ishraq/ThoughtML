+def test_partial_structure_nested_partial(converter: BaseConverter):
+    res = converter.partial_structure({"a": 1, "inner": {"x": 5}}, A)
+
+    # The nested object is only partially complete, so its partial value is
+    # used, and the parent field is marked as failed.
+    assert res.value == A(1, "default", Inner(5, 0))
+    assert res.structured_fields == frozenset({"a"})
+    assert res.failed_fields == frozenset({"b", "inner"})
+    assert "inner" in res.error_map
+    assert not res.is_complete
+
+
+def test_partial_structure_nested_no_value(converter: BaseConverter):
+    res = converter.partial_structure({"a": 1, "inner": {"x": "nope"}}, A)
+
+    # No value can be produced at all - a normal field failure, so the field's
+    # default is used as the fallback.
+    assert res.value == A(1, "default", Inner(1, 2))
+    assert res.failed_fields == frozenset({"b", "inner"})
+    assert res.structured_fields == frozenset({"a"})
+    assert not res.is_complete
+
